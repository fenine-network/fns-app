NEXT_PUBLIC_PROVIDER=http://localhost:8545
NEXT_PUBLIC_ETH_NODE=anvil
NEXT_PUBLIC_NATIVE_TLD=eth
NEXT_PUBLIC_ENS_SUBGRAPH_URL=http://localhost:42069/subgraph
