# Fenine production defaults
NEXT_PUBLIC_CHAIN_NAME=mainnet
NEXT_PUBLIC_NATIVE_TLD=fen
NEXT_PUBLIC_ENS_SUBGRAPH_URL=https://subgraph.fenine.codes/subgraphs/name/fenine/fns
NEXT_PUBLIC_METADATA_BASE_URL=https://metadata.fenine.codes
NEXT_PUBLIC_RPC_WS_URL=wss://rpc.fene.app/ws
NEXT_PUBLIC_AVUP_ENDPOINT=https://avatar-upload.fenine.codes
NEXT_PUBLIC_USD_ORACLE_NAME=fen-usd.data.fen

# Optional but recommended
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_INTERCOM_ID=re9q5yti
# NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_key

# Only set this if you want to override compiled deployment addresses.
# Normally production uses addresses from ens-contracts/deployments/fenine.
# NEXT_PUBLIC_DEPLOYMENT_ADDRESSES={}
